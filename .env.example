# Use as a template for config.env (LaunchAgent) or .env (direct runs).
# Run `pnpm token:generate` to create ~/.config/omnifocus-mcp-bridge/token.
# No token-file override is needed for the default location.
# OMNIFOCUS_MCP_HOST=127.0.0.1
# OMNIFOCUS_MCP_PORT=3050
# OMNIFOCUS_MCP_READ_ONLY=true
# OMNIFOCUS_MCP_VERBOSE=false
# OMNIFOCUS_MCP_TAILSCALE_SERVE=false
